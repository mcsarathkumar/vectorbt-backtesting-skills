# =============================================================================
# VectorBT Backtesting Environment Configuration
# Copy this file to .env and fill in your API keys
#   cp .env.sample .env
# =============================================================================

# --- Indian Markets (local Parquet candle store) ---
# Default location shown; no API key needed. Layout: <EXCHANGE>/<SYMBOL>/<interval>/*.parquet
CANDLES_DIR=/Users/mcsarathkumar/Workspace/indian-market-data/data/candles

# --- US Markets ---
# yfinance does not require an API key (uses Yahoo Finance public data)
# No configuration needed for US stocks, ETFs, indices

# --- Crypto Markets (CCXT) ---
# Optional: Only needed for private endpoints (account data, order placement)
# Public market data (OHLCV) does NOT require API keys
# Get your keys from your exchange's API management page
CRYPTO_API_KEY=
CRYPTO_SECRET_KEY=

# --- Custom Data Providers (Optional) ---
# Add your own provider's API keys below.
# See rules/data-fetching.md "Custom Data Provider" section for setup guide.

# Alpaca Markets
# ALPACA_API_KEY=
# ALPACA_SECRET_KEY=
# ALPACA_BASE_URL=https://paper-api.alpaca.markets

# Twelve Data
# TWELVEDATA_API_KEY=
